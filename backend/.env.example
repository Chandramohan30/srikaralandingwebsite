# Copy this file to .env and fill in your own values.

# MongoDB Atlas connection string.
# Get this from Atlas -> Database -> Connect -> Drivers -> Node.js
# Replace <username>, <password>, and the DB name (srikara) as needed.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/srikara?retryWrites=true&w=majority

# Port the Express server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173
